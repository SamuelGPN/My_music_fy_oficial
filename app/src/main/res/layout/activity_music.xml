<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imageViewMusica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/music_backgrounds"
        app:layout_constraintTop_toBottomOf="@id/tituloMusica"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="60dp"
        />


    <TextView
        android:id="@+id/tituloMusica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TÍtulo da Música"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="70dp" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/homebtn"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/homebtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/botao_circular"
            android:contentDescription="Home"
            android:src="@drawable/home_icon" />

        <ImageButton
            android:id="@+id/previousbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="55dp"
            android:background="@drawable/botao_circular"
            android:contentDescription="Previous"
            android:src="@drawable/skip_previous_icon" />


        <ImageButton
            android:id="@+id/pausarbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="23dp"
            android:background="@drawable/botao_circular"
            android:contentDescription="Pausar"
            android:src="@drawable/pause_icon" />

        <ImageButton
            android:id="@+id/nextbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="23dp"
            android:background="@drawable/botao_circular"
            android:contentDescription="Next"
            android:src="@drawable/skip_next_icon" />

        <ImageButton
            android:id="@+id/favoritobtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="55dp"
            android:background="@drawable/botao_circular"
            android:contentDescription="Favorito"
            android:src="@drawable/favorite_icon" />

    </LinearLayout>

</LinearLayout>

